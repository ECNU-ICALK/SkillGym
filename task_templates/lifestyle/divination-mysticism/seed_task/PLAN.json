  "instruction_design": {
    "principles": [
      "题面只交代业务目标、输入材料、正式输出合同和禁止事项。",
      "不在 instruction 中直接展开 archive 路径、命令语法或 verifier 逻辑。",
      "保留支持证据要求，但把具体读取流程留给 skill 和 solver 自己识别。",
      "明确禁止改动候选集、目标年份和约束定义。"
    ],
    "expected_solver_discovery": [
      "识别出需要查阅绑定 skill，或手动重建其历法读取工作流。",
      "识别出仅靠公开参考材料不够高效，最好使用环境内已 provision 的 archive 工具链。",
      "在日期解析、候选过滤、证据整理和交付合同之间收敛出一套完整交付包。"
    ]
  },
  "verifier_design": {
    "main_tests": [
      "输出文件存在且 schema 正确",
      "按 archive 数据重算全部候选日期与 weekday",
      "按 policy 和 ops 约束重算最终 4 个入选节俗活动",
      "证据文件、resolution、schedule 和 report 之间保持一致"
    ],
    "guardrails": [
      "x command access log 必须证明 solver 走过 canonical archive 读取链路",
      "公开输入、x archive 和本地工具文件不得被修改",
      "skill consultation check 保持可选，without_skill 仍能正常启动和结算",
      "全部测试点都必须执行，不能中途退出"
    ],
    "without_skill_failure_target": "without_skill 至少保留一项行动级失败，优先是没有走 canonical archive workflow、未解析全量候选、选错活动、缺证据文件，或 cross-file 不一致。"
  },
