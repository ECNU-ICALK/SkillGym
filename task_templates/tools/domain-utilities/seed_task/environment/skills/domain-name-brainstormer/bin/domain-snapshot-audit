#!/usr/bin/env python3
from __future__ import annotations

import argparse
import csv
import json
from pathlib import Path


PREFERRED_STYLE_TAGS = {"workflow", "automation", "deployment", "observability", "infra"}
WEIGHTS = {
    "brandability": 0.33,
    "pronounceability": 0.24,
    "developer_fit": 0.31,
    "style_match_per_hit": 0.12,
}
TLD_BONUS = {
    "com": 0.58,
    "ai": 0.52,
    "tech": 0.40,
    "xyz": 0.26,
}
LENGTH_BONUS_RULES = [
    {"min": 8, "max": 10, "bonus": 0.16},
    {"min": 11, "max": 12, "bonus": 0.08},
    {"min": 13, "max": 14, "bonus": 0.00},
]


def length_bonus(length: int) -> float:
    for rule in LENGTH_BONUS_RULES:
        if int(rule["min"]) <= length <= int(rule["max"]):
            return float(rule["bonus"])
    return 0.0


def build_outputs(data_dir: Path) -> tuple[list[dict[str, object]], dict[str, object]]:
    policy = json.loads((data_dir / "tld_policy.json").read_text(encoding="utf-8"))
    allowed_tlds = list(policy["allowed_tlds"])
    tld_order = {value: idx for idx, value in enumerate(allowed_tlds)}

    candidates: dict[str, dict[str, object]] = {}
    with (data_dir / "candidate_pool.csv").open(newline="") as handle:
        for row in csv.DictReader(handle):
            tags = [part.strip() for part in row["style_tags"].split(";") if part.strip()]
            candidates[row["base_name"]] = {
                "brandability": float(row["brandability"]),
                "pronounceability": float(row["pronounceability"]),
                "developer_fit": float(row["developer_fit"]),
                "style_tags": tags,
                "length": len(row["base_name"]),
            }

    snapshot: list[dict[str, str]] = []
    with (data_dir / "availability_snapshot.csv").open(newline="") as handle:
        snapshot = list(csv.DictReader(handle))

    audit_rows: list[dict[str, object]] = []
    for row in snapshot:
        base_name = row["base_name"]
        candidate = candidates[base_name]
        style_match_count = sum(1 for value in candidate["style_tags"] if value in PREFERRED_STYLE_TAGS)
        row_length_bonus = length_bonus(int(candidate["length"]))
        row_tld_bonus = float(TLD_BONUS[row["tld"]])
        score = (
            candidate["brandability"] * WEIGHTS["brandability"]
            + candidate["pronounceability"] * WEIGHTS["pronounceability"]
            + candidate["developer_fit"] * WEIGHTS["developer_fit"]
            + style_match_count * WEIGHTS["style_match_per_hit"]
            + row_length_bonus
            + row_tld_bonus
        )
        audit_rows.append(
            {
                "base_name": base_name,
                "tld": row["tld"],
                "domain": row["domain"],
                "availability": row["availability"],
                "score": score,
                "brandability": candidate["brandability"],
                "pronounceability": candidate["pronounceability"],
                "developer_fit": candidate["developer_fit"],
                "style_match_count": style_match_count,
                "length_bonus": row_length_bonus,
                "tld_bonus": row_tld_bonus,
                "length": candidate["length"],
                "style_tags": candidate["style_tags"],
            }
        )

    audit_rows.sort(key=lambda value: (value["base_name"], tld_order[value["tld"]], value["domain"]))
    available_rows = [row for row in audit_rows if row["availability"] == "available"]
    taken_rows = [row for row in audit_rows if row["availability"] == "taken"]

    def domain_sort_key(row: dict[str, object]) -> tuple[float, int, str]:
        return (-float(row["score"]), tld_order[str(row["tld"])], str(row["domain"]))

    best_available_by_base: dict[str, dict[str, object]] = {}
    for row in sorted(available_rows, key=domain_sort_key):
        best_available_by_base.setdefault(str(row["base_name"]), row)

    ranked_bases = sorted(best_available_by_base.values(), key=lambda row: (-float(row["score"]), str(row["base_name"])))
    shortlist_rows = ranked_bases[: int(policy["shortlist_size"])]
    runner_rows = ranked_bases[int(policy["shortlist_size"]): int(policy["shortlist_size"]) + int(policy["runner_up_size"])]
    taken_rows = sorted(taken_rows, key=domain_sort_key)[: int(policy["taken_showcase_size"])]

    shortlist = []
    for idx, row in enumerate(shortlist_rows, start=1):
        shortlist.append(
            {
                "rank": idx,
                "domain": row["domain"],
                "base_name": row["base_name"],
                "tld": row["tld"],
                "availability": "available",
                "score": round(float(row["score"]), 3),
                "length": int(row["length"]),
                "style_tags": list(row["style_tags"]),
                "why_it_fits": f"{row['base_name']} keeps a compact developer-tool tone and pairs well with .{row['tld']} for this launch brief.",
            }
        )

    payload = {
        "project_slug": policy["project_slug"],
        "evaluated_tlds": allowed_tlds,
        "shortlist": shortlist,
        "runner_ups": [row["domain"] for row in runner_rows],
        "rejected_taken_domains": [row["domain"] for row in taken_rows],
        "top_pick_summary": f"{shortlist_rows[0]['domain']} leads the pack because it combines the strongest available score with a compact base name and clear developer-tool positioning.",
    }
    return audit_rows, payload


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--data-dir", default="/root/workspace/data")
    parser.add_argument("--output-dir", default="")
    args = parser.parse_args()

    audit_rows, payload = build_outputs(Path(args.data_dir))
    if args.output_dir:
        output_dir = Path(args.output_dir)
        output_dir.mkdir(parents=True, exist_ok=True)
        with (output_dir / "availability_audit.csv").open("w", newline="") as handle:
            writer = csv.writer(handle)
            writer.writerow(
                [
                    "base_name",
                    "tld",
                    "domain",
                    "availability",
                    "score",
                    "brandability",
                    "pronounceability",
                    "developer_fit",
                    "style_match_count",
                    "length_bonus",
                    "tld_bonus",
                ]
            )
            for row in audit_rows:
                writer.writerow(
                    [
                        row["base_name"],
                        row["tld"],
                        row["domain"],
                        row["availability"],
                        f"{float(row['score']):.3f}",
                        f"{float(row['brandability']):.3f}",
                        f"{float(row['pronounceability']):.3f}",
                        f"{float(row['developer_fit']):.3f}",
                        row["style_match_count"],
                        f"{float(row['length_bonus']):.3f}",
                        f"{float(row['tld_bonus']):.3f}",
                    ]
                )
        (output_dir / "domain_shortlist.json").write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
    else:
        print(json.dumps(payload, indent=2))


if __name__ == "__main__":
    main()
