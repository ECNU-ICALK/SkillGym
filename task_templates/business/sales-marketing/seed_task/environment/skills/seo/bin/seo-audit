#!/usr/bin/env python3
from __future__ import annotations

import json
import sys
import urllib.parse
import urllib.request


BASE = "http://127.0.0.1:8139"


def get(path: str) -> dict:
    req = urllib.request.Request(
        BASE + path,
        headers={"X-Client": "seo-audit-cli"},
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.loads(resp.read().decode("utf-8"))


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print("usage: seo-audit <health|crawl|release-gate|page|sitemap|link-graph>", file=sys.stderr)
        return 2
    cmd = argv[1]
    if cmd == "health":
        payload = get("/health")
    elif cmd == "crawl":
        payload = get("/api/crawl")
    elif cmd == "release-gate":
        payload = get("/api/release-gate")
    elif cmd == "page":
        if len(argv) < 3:
            print("usage: seo-audit page <page-id>", file=sys.stderr)
            return 2
        payload = get("/api/page/" + urllib.parse.quote(argv[2], safe=""))
    elif cmd == "sitemap":
        payload = get("/api/sitemap")
    elif cmd == "link-graph":
        payload = get("/api/link-graph")
    else:
        print(f"unknown command: {cmd}", file=sys.stderr)
        return 2
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
