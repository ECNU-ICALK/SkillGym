  "window_rules": {
    "window_days": 3,
    "min_daily_sst_anom_c": 1.0,
    "min_daily_sst_anom_operator": "strictly_greater_than",
    "top_k": 3,
    "selection_note": "meets_contract_window_rules"
  },
  "output_contract": {
    "analysis_intake_headings": [
      "Scope",
      "Input summary",
      "Data issues",
