{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "namespace",
    "environment",
    "replicaCount",
    "image",
    "serviceAccount",
    "service",
    "container",
    "config",
    "secretEnv",
    "resources",
    "ingress",
    "autoscaling",
    "pdb"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "minLength": 1}
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "annotations": {"type": "object"}
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port", "metricsPort"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1},
        "metricsPort": {"type": "integer", "minimum": 1}
      }
    },
    "container": {
      "type": "object",
      "required": ["port"],
      "properties": {
        "port": {"type": "integer", "minimum": 1}
      }
    },
    "config": {
      "type": "object",
      "required": ["LOG_FORMAT", "CACHE_STRATEGY", "FEATURE_BANNER", "LOG_LEVEL"],
      "properties": {
        "LOG_FORMAT": {"type": "string", "minLength": 1},
        "CACHE_STRATEGY": {"type": "string", "minLength": 1},
        "FEATURE_BANNER": {"type": "string", "minLength": 1},
        "LOG_LEVEL": {"type": "string", "minLength": 1}
      }
    },
    "secretEnv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "secretName", "key"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "secretName": {"type": "string", "minLength": 1},
          "key": {"type": "string", "minLength": 1}
        }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": "string", "minLength": 1},
            "memory": {"type": "string", "minLength": 1}
          }
        },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"],
          "properties": {
            "cpu": {"type": "string", "minLength": 1},
            "memory": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "host", "path", "pathType"],
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {"type": "object"},
        "host": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "pathType": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {"const": true}
            }
          },
          "then": {
            "properties": {
              "host": {"minLength": 1},
              "className": {"minLength": 1}
            }
          }
        }
      ]
    },
    "autoscaling": {
      "type": "object",
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "targetCPUUtilizationPercentage",
        "targetMemoryUtilizationPercentage"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "targetCPUUtilizationPercentage": {"type": "integer", "minimum": 1},
        "targetMemoryUtilizationPercentage": {"type": "integer", "minimum": 1}
      }
    },
    "pdb": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": "integer", "minimum": 1}
      }
    }
  }
}
