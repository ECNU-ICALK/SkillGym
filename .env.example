# SkillGym Task Builder environment template
#
# The Task Builder reads these values from the process environment.
# This file is a reference template and is not loaded automatically.
# Export only the variables needed by your setup.

# OpenAI-compatible endpoint used by the optional skill-effect evaluator.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional Codex SDK overrides.
# Path to a custom Codex executable. Leave empty to use the SDK default.
CODEX_PATH=

# Optional model override for Task Builder Codex threads.
CODEX_TASK_BUILDER_MODEL=

# Sandbox mode: set to "workspace-write" for the restricted mode.
# Any other value (including empty) uses the current default: danger-full-access.
CODEX_TASK_BUILDER_SANDBOX_MODE=

# Network access: set to "0" to disable. Any other value enables it.
CODEX_TASK_BUILDER_NETWORK_ACCESS=
